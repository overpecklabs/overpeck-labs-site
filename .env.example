# Overpeck Labs site: environment variable names (placeholders only, never real values).
# Real values live in Vercel > Project Settings > Environment Variables and in your local .env.local (gitignored).

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Stripe Payment Links for the pricing "Get started" buttons (build-time: redeploy after changing)
NEXT_PUBLIC_STRIPE_LINK_STARTER=
NEXT_PUBLIC_STRIPE_LINK_GROWTH=
NEXT_PUBLIC_STRIPE_LINK_PRO=

# Optional: intake form link shown on /welcome and in the welcome email
NEXT_PUBLIC_INTAKE_URL=

# Server only (never prefix with NEXT_PUBLIC_)
STRIPE_WEBHOOK_SECRET=
# Shared secret for the billing database functions (its SHA-256 hash is stored in Supabase; see the
# client_subscriptions migration). Never a Supabase service role or secret key.
BILLING_RPC_SECRET=
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
# Optional (defaults: smtp.zoho.com, 465, support@overpecklabs.com)
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=
NOTIFY_EMAIL=
